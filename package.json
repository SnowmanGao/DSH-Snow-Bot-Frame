{
  "name": "dsh-snow-bot-frame",
  "icon": "assets/icon.png",
  "version": "0.4.50",
  "title": "QQ 机器人雪人框架 (dsh-snow-bot-frame)",
  "description": "[Snowman] QQ Bot 插件，优化流程，注入自有工具，同时节约 Token 消耗，基于官方机器人和 Tulpa 项目。",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "config": {
    "dshCli": "D:/Study_/DSHarness/resources/runtime/cli/bin/dsh.cmd",
    "dshProfile": "desktop"
  },
  "files": [
    "dist",
    "assets",
    "cordis.patch.yml",
    "client.js"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "demo": "tsx src/_dev_scripts/demo.ts",
    "release": "node src/_dev_scripts/release.ts release",
    "pack-only": "node src/_dev_scripts/release.ts pack-only"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "yaml": "^2.8.1"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": ">=3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "^3.18.5",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
